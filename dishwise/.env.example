# Copy to .env.local and fill in what you need. Everything is optional:
# with nothing set, Dishwise runs with sample menus, pasted text and rules-based picks.

# ——— AI (optional) ———
# Enables reading menu photos/PDFs and AI-written explanations & picks.
# Get a key at https://console.anthropic.com/  (keep it secret, server-side only)
ANTHROPIC_API_KEY=
# DISHWISE_AI_MODEL=claude-opus-5-5
# DISHWISE_AI_EFFORT=low          # low | medium | high (higher = slower, more thorough)
# DISHWISE_DISABLE_AI=1           # force rules-only mode even if a key is set

# ——— Founder dashboard ———
# Required in production. Visit /founder and enter this passcode.
FOUNDER_PASSCODE=

# ——— Analytics storage (recommended when deployed) ———
# Without these, events go to .data/events.ndjson locally (temporary on Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
